<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone. A reinstall must start
     fresh: restoring the old app data brought back the old guest session and
     the "install already recorded" flag, so an install from an ad was never
     credited to the ad. (Android 12+; older versions: allowBackup="false".) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
